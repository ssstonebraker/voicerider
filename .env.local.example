# VoiceRider local environment overrides
#
# Copy this file to `.env.local` (which is gitignored) and edit the
# values for your setup. The build scripts (build.sh, prod-build.sh,
# Makefile) source `.env.local` if present and use it to render
# Resources/Info.plist from Resources/Info.plist.template.
#
# Anything you put here stays on your machine — `.env.local` is
# gitignored.
#
# ────────────────────────────────────────────────────────────────────
# VOICERIDER_LAN_HOST
# ────────────────────────────────────────────────────────────────────
# The hostname or IP that the macOS App Transport Security exception
# in Info.plist will whitelist for plain-HTTP. Must match the host in
# `voicerider.serverURL` (which you can override with
# `defaults write com.voicerider voicerider.serverURL ...`).
#
# Examples:
#   VOICERIDER_LAN_HOST=localhost          # the committed default
#   VOICERIDER_LAN_HOST=linux              # an /etc/hosts alias
#   VOICERIDER_LAN_HOST=192.168.1.42/32    # IP address with /32 CIDR
#
VOICERIDER_LAN_HOST=localhost
